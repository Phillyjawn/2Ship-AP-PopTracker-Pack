{
 "day_night_grid": {
  "type": "itemgrid",
  "h_alignment": "center",
  "v_alignment": "center",
  "item_margin": "1,1",
  "rows": [
   [
    "time_day1",
    "time_night1",
    "time_day2",
    "time_night2",
    "time_day3",
    "time_night3"
   ]
  ]
 },
 "day_time_and_sanities": {
  "type": "array",
  "orientation": "vertical",
  "content": [
   {
    "type": "layout",
    "key": "day_night_grid"
   },
   {
    "type": "array",
    "orientation": "horizontal",
    "content": [
     { "type": "item", "max_width": 130, "item": "skullsanity" },
     { "type": "item", "max_width": 130, "item": "shopsanity" },
     { "type": "item", "max_width": 130, "item": "scrubsanity" },
     { "type": "item", "max_width": 130, "item": "cowsanity" },
     { "type": "item", "max_width": 130, "item": "fairysanity" }
    ]
   },
   {
    "type": "array",
    "orientation": "horizontal",
    "content": [
     { "type": "item", "max_width": 40, "item": "shuffle_grass_drops" },
     { "type": "item", "max_width": 40, "item": "shuffle_pot_drops" },
     { "type": "item", "max_width": 40, "item": "shuffle_tree_drops" },
     { "type": "item", "max_width": 40, "item": "shuffle_crate_drops" },
     { "type": "item", "max_width": 40, "item": "exclude_termina_field_grass" },
     { "type": "item", "max_width": 40, "item": "exclude_cow_grotto_grass" },
     { "type": "item", "max_width": 40, "item": "shuffle_owl_statues" }
    ]
   }
  ]
 }
}
